# Copy to ~/.config/thesis-notify.env and fill in. That path is outside the
# repo, so the app password below can never be committed.
#
#   cp tools/notify.env.example ~/.config/thesis-notify.env
#   chmod 600 ~/.config/thesis-notify.env
#   $EDITOR ~/.config/thesis-notify.env
#   ./run_all.sh notify-test
#
# Use either channel, or both. Leave a block commented out to disable it.

# ── Channel A: push to your phone via ntfy.sh ────────────────────────────
# Install the "ntfy" app (Android/iOS), subscribe to exactly this topic, done.
# No account. The topic name is the ONLY secret, so this pre-generated random
# one is the point -- do not shorten it to something guessable.
NOTIFY_NTFY_TOPIC=thesis-sqg-thr76y7h6n3656a

# ── Channel B: email, to read in Gmail/Outlook on your phone ─────────────
# Gmail needs an App Password, NOT your normal password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# Outlook/Office365: host smtp.office365.com, port 587.
#NOTIFY_EMAIL_TO=2811143654c@gmail.com
#NOTIFY_SMTP_HOST=smtp.gmail.com
#NOTIFY_SMTP_PORT=587
#NOTIFY_SMTP_USER=2811143654c@gmail.com
#NOTIFY_SMTP_PASS=put-the-16-char-app-password-here
